{
  "name": "subzerodev-github",
  "private": true,
  "description": "GitHub repositories under OpenTofu management, and the scripts that scaffold and publish new projects.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings scripts tests",
    "test": "node --test \"tests/*.test.ts\"",
    "test:tofu": "node --test tests/tofu.integration.ts",
    "smoke": "node tests/node-smoke.ts",
    "smoke:starter": "node tests/starter-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
